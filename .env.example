# Copy to .env.local and fill in. Never commit real values.
# Validated at boot by src/server/config.ts (PRD §17). Missing optional keys
# show a visible "Not configured" state; nothing is faked.

# --- App ---
# Public base URL, used for links in emails and Stripe redirects.
APP_URL=http://localhost:3000

# --- Database (required, server-only) ---
# MongoDB Atlas connection string.
MONGODB_URI=
# Database name inside the cluster.
MONGODB_DB=wellspring

# --- Auth.js (required) ---
# Random secret, e.g. `openssl rand -base64 32`.
AUTH_SECRET=
# Canonical URL Auth.js uses for callbacks (usually same as APP_URL).
AUTH_URL=http://localhost:3000

# --- Field encryption (required, server-only) ---
# base64-encoded 32 bytes, e.g. `openssl rand -base64 32`. Protects
# private_reflections, pastoral_notes and prayer request text.
FIELD_ENC_KEY=
# Key id stored with each ciphertext, bump when rotating.
FIELD_ENC_KID=k1

# --- Stripe (optional: without it checkout shows "Payments not configured") ---
STRIPE_SECRET_KEY=
# Signing secret for /api/stripe/webhook; payment status comes only from verified webhooks.
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# --- Email via Resend (optional: without it email shows "Not configured") ---
RESEND_API_KEY=
# Verified sender, e.g. "Wellspring Care <care@example.org>".
EMAIL_FROM=

# --- Google Calendar (optional) ---
GOOGLE_CALENDAR_CLIENT_ID=
GOOGLE_CALENDAR_CLIENT_SECRET=

# --- Cron ---
# Bearer secret protecting /api/cron/* (Vercel Cron).
CRON_SECRET=
